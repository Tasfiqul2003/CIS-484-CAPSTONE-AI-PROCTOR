POSTGRES_USER=proctor
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=examdb
BASE_MODEL=llama3.1
OLLAMA_MODEL=llama3.1
DATABASE_URL=postgresql+psycopg2://proctor:replace_with_a_local_password@db:5432/examdb

# Generate a real secret with: openssl rand -hex 32
# Put the generated value in your local .env file. Never commit that value.
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-token

# Air-gapped update stack: replace every placeholder before deployment.
APP_DOCKER_NETWORK=replace-with-existing-app-network
OLLAMA_MODELS_VOLUME=replace-with-existing-ollama-volume
EXAM_VIDEO_VOLUME=replace-with-existing-recording-volume
BACKEND_IMAGE=oralexam-backend:airgap
FRONTEND_IMAGE=oralexam-frontend:airgap
OLLAMA_IMAGE=ollama/ollama:latest
EXAM_VIDEO_RETENTION_UNTIL=YYYY-MM-DD
FACE_MODELS_DIR=/srv/oral-exam/models
TLS_CERT_DIR=/srv/oral-exam/tls
HTTP_PORT=80
HTTPS_PORT=443
