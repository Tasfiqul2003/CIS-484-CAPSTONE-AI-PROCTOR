FROM python:3.12-slim
WORKDIR /app
COPY requirements-transcription.txt ./
RUN pip install --no-cache-dir -r requirements-transcription.txt
COPY app ./app
ENV PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
CMD ["python", "-m", "app.transcription_worker"]
